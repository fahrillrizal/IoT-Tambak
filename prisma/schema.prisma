generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DeviceType {
  SENSOR
  FEEDER
  CONTROLLER
  HYBRID

  @@map("device_type")
}

enum DeviceStatus {
  ACTIVE
  INACTIVE
  ERROR
  MAINTENANCE

  @@map("device_status")
}

enum FeedingType {
  SCHEDULED
  MANUAL
  CONDITIONAL
  AI

  @@map("feeding_type")
}

enum FeedingStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED

  @@map("feeding_status")
}

model User {
  id            Int       @id @default(autoincrement())
  name          String?
  username      String?   @unique @db.VarChar(50)
  email         String    @unique @db.VarChar(100)
  password      String?   @db.VarChar(255)
  emailVerified DateTime? @map("email_verified")
  image         String?
  phone         String?   @db.VarChar(15)
  provinceId    Int?      @map("province_id")
  cityId        Int?      @map("regency_id")
  address       String?   @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime? @updatedAt @map("updated_at")

  ponds    Pond[]
  accounts Account[]
  sessions Session[]

  @@index([email])
  @@index([username])
  @@map("users")
}

model Account {
  id                Int     @id @default(autoincrement())
  userId            Int     @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique @map("session_token")
  userId       Int      @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Pond {
  id                  Int       @id @default(autoincrement())
  userId              Int       @map("user_id")
  name                String    @db.VarChar(100)
  pondSize            Decimal?  @map("pond_size") @db.Decimal(10, 2)
  waterVolume         Decimal?  @map("water_volume") @db.Decimal(10, 2)
  shrimpAgeDays       Int?      @default(0) @map("shrimp_age_days")
  biomass             Decimal?  @db.Decimal(10, 2)
  stockingDate        DateTime? @map("stocking_date")
  thingsboardDeviceId String?   @map("thingsboard_device_id") @db.VarChar(255)
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  devices          Device[]
  feedingSchedules FeedingSchedule[]
  dailySummaries   DailySummary[]
  hourlySummaries  HourlySummary[]

  @@index([userId])
  @@index([isActive])
  @@index([thingsboardDeviceId])
  @@map("ponds")
}

model Device {
  id                  Int              @id @default(autoincrement())
  pondId              Int              @map("pond_id")
  name                String           @db.VarChar(100)
  deviceType          DeviceType       @map("device_type")
  deviceToken         String           @unique @map("device_token") @db.VarChar(255)
  deviceStatus        DeviceStatus     @default(ACTIVE) @map("device_status")
  thingsboardDeviceId String?          @unique @map("thingsboard_device_id") @db.VarChar(255)
  firmwareVersion     String?          @map("firmware_version") @db.VarChar(50)
  hardwareVersion     String?          @map("hardware_version") @db.VarChar(50)
  notes               String?          @db.Text
  isActive            Boolean          @default(true) @map("is_active")
  lastHeartbeat       DateTime?        @map("last_heartbeat")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  pond                Pond             @relation(fields: [pondId], references: [id], onDelete: Cascade)
  feedingHistory      FeedingHistory[]

  @@index([pondId])
  @@index([deviceToken])
  @@index([thingsboardDeviceId])
  @@index([deviceStatus])
  @@index([isActive])
  @@map("devices")
}

model FeedingSchedule {
  id                 Int      @id @default(autoincrement())
  pondId             Int      @map("pond_id")
  name               String   @db.VarChar(100)
  time               String   @db.VarChar(5)
  amount             Decimal  @db.Decimal(10, 2)
  daysOfWeek         String   @map("days_of_week") @db.Text
  conditionalFeeding Boolean  @default(false) @map("conditional_feeding")
  minPh              Decimal? @map("min_ph") @db.Decimal(4, 2)
  maxPh              Decimal? @map("max_ph") @db.Decimal(4, 2)
  minDo              Decimal? @map("min_do") @db.Decimal(4, 2)
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  pond               Pond     @relation(fields: [pondId], references: [id], onDelete: Cascade)

  @@index([pondId])
  @@index([isActive])
  @@index([time])
  @@map("feeding_schedules")
}

model FeedingHistory {
  id              BigInt        @id @default(autoincrement()) @db.BigInt
  deviceId        Int           @map("device_id")
  pondId          Int           @map("pond_id")
  feedingType     FeedingType   @map("feeding_type")
  feedingStatus   FeedingStatus @default(COMPLETED) @map("feeding_status")
  amount          Decimal       @db.Decimal(10, 2)
  plannedAmount   Decimal?      @map("planned_amount") @db.Decimal(10, 2)
  temperature     Decimal?      @db.Decimal(5, 2)
  ph              Decimal?      @db.Decimal(4, 2)
  dissolvedOxygen Decimal?      @map("dissolved_oxygen") @db.Decimal(5, 2)
  salinity        Decimal?      @db.Decimal(5, 2)
  turbidity       Decimal?      @db.Decimal(6, 2)
  scheduledAt     DateTime?     @map("scheduled_at")
  executedAt      DateTime      @default(now()) @map("executed_at")
  triggeredBy     Int?          @map("triggered_by")
  notes           String?       @db.Text
  device          Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([pondId])
  @@index([executedAt])
  @@index([feedingType])
  @@index([feedingStatus])
  @@map("feeding_history")
}

model DailySummary {
  id                 Int      @id @default(autoincrement())
  pondId             Int      @map("pond_id")
  date               DateTime @db.Date
  avgTemperature     Decimal  @map("avg_temperature") @db.Decimal(5, 2)
  minTemperature     Decimal  @map("min_temperature") @db.Decimal(5, 2)
  maxTemperature     Decimal  @map("max_temperature") @db.Decimal(5, 2)
  avgPh              Decimal  @map("avg_ph") @db.Decimal(4, 2)
  minPh              Decimal  @map("min_ph") @db.Decimal(4, 2)
  maxPh              Decimal  @map("max_ph") @db.Decimal(4, 2)
  avgDissolvedOxygen Decimal  @map("avg_dissolved_oxygen") @db.Decimal(5, 2)
  minDissolvedOxygen Decimal  @map("min_dissolved_oxygen") @db.Decimal(5, 2)
  maxDissolvedOxygen Decimal  @map("max_dissolved_oxygen") @db.Decimal(5, 2)
  avgSalinity        Decimal  @map("avg_salinity") @db.Decimal(5, 2)
  minSalinity        Decimal  @map("min_salinity") @db.Decimal(5, 2)
  maxSalinity        Decimal  @map("max_salinity") @db.Decimal(5, 2)
  avgTurbidity       Decimal  @map("avg_turbidity") @db.Decimal(6, 2)
  minTurbidity       Decimal  @map("min_turbidity") @db.Decimal(6, 2)
  maxTurbidity       Decimal  @map("max_turbidity") @db.Decimal(6, 2)
  dataPoints         Int      @default(0) @map("data_points")
  createdAt          DateTime @default(now()) @map("created_at")
  pond               Pond     @relation(fields: [pondId], references: [id], onDelete: Cascade)

  @@unique([pondId, date])
  @@index([pondId])
  @@index([date])
  @@map("daily_summaries")
}

model HourlySummary {
  id                 Int      @id @default(autoincrement())
  pondId             Int      @map("pond_id")
  timestamp          DateTime
  avgTemperature     Decimal  @map("avg_temperature") @db.Decimal(5, 2)
  minTemperature     Decimal  @map("min_temperature") @db.Decimal(5, 2)
  maxTemperature     Decimal  @map("max_temperature") @db.Decimal(5, 2)
  avgPh              Decimal  @map("avg_ph") @db.Decimal(4, 2)
  minPh              Decimal  @map("min_ph") @db.Decimal(4, 2)
  maxPh              Decimal  @map("max_ph") @db.Decimal(4, 2)
  avgDissolvedOxygen Decimal  @map("avg_dissolved_oxygen") @db.Decimal(5, 2)
  minDissolvedOxygen Decimal  @map("min_dissolved_oxygen") @db.Decimal(5, 2)
  maxDissolvedOxygen Decimal  @map("max_dissolved_oxygen") @db.Decimal(5, 2)
  avgSalinity        Decimal  @map("avg_salinity") @db.Decimal(5, 2)
  avgTurbidity       Decimal  @map("avg_turbidity") @db.Decimal(6, 2)
  dataPoints         Int      @default(0) @map("data_points")
  createdAt          DateTime @default(now()) @map("created_at")
  pond               Pond     @relation(fields: [pondId], references: [id], onDelete: Cascade)

  @@unique([pondId, timestamp])
  @@index([pondId])
  @@index([timestamp])
  @@map("hourly_summaries")
}

model PasswordResetOTP {
  id           Int       @id @default(autoincrement())
  email        String    @db.VarChar(100)
  otp          String    @db.VarChar(5)
  expiresAt    DateTime  @map("expires_at")
  verified     Boolean   @default(false)
  resendCount  Int       @default(0) @map("resend_count")
  lastResendAt DateTime? @map("last_resend_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@index([otp])
  @@map("password_reset_otps")
}
